# Build output (scripts/build.sh; OUT=... builds go to other bin* directories)
/bin*/
# The endgame tables, when built under the repository (default build/tables)
/build/
*.o
*.a
# The Python extension (python/build.sh) and Python caches
python/ddfast/*.so
python/ddfast/*.dylib
__pycache__/
# DDS writes dump.txt on error cases (python/tests/test_dds_capi.py runs a real libdds)
dump.txt
